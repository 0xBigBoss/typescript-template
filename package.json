{
  "name": "typescript-template",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "setup": "nub scripts/setup.ts",
    "build": "nub run -r --filter './packages/*' build && nub run -r --filter './apps/*' build",
    "typecheck": "tsc -b",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "nub run typecheck && nub run lint && nub run format:check",
    "knip": "knip",
    "jscpd": "jscpd .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "nub run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jscpd": "^5.0.12",
    "knip": "^6.29.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "zshy": "^0.7.3"
  }
}
