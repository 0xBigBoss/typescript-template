{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    // tsdown owns dist/. tsc emits declarations only, into its own directory, so
    // the two never fight: tsdown's clean step would otherwise delete tsc's
    // output while .tsbuildinfo still claimed it was up to date (TS6305).
    "outDir": "./.tsbuild",
    "rootDir": "./src",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true
  },
  "include": ["src"],
  "references": [
    {
      "path": "../core"
    }
  ]
}
